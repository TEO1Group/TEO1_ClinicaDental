DB_NAME=clinica_dental
DB_USERNAME=postgres
DB_PASSWORD=
JWT_SECRET=
# En EC2 debe ser el origen público real del frontend; localhost solo aplica al desarrollo local.
CORS_ALLOWED_ORIGINS=http://localhost:4200
JWT_EXPIRATION_MS=86400000

# Primer administrador; se crea al arrancar el backend solo si no existe ningun ADMIN.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Correo de recordatorio de citas. Si SMTP_HOST o SMTP_FROM quedan vacíos no se envían correos.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Vacío en local (se construye desde ./backend); en EC2 usar la imagen de GHCR
BACKEND_IMAGE=

# Vacío en local (se construye desde ./clinica-dental-frontend); en EC2 usar la imagen de GHCR
FRONTEND_IMAGE=
