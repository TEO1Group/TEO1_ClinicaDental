1" parent="c53"><mxGeometry x="1100" y="40" width="210" height="70" as="geometry"/></mxCell><mxCell id="c59" value="&lt;b&gt;6.&lt;/b&gt; docker compose up -d&lt;br&gt;--force-recreate&lt;br&gt;backend frontend" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="c53"><mxGeometry x="1100" y="160" width="210" height="80" as="geometry"/></mxCell><mxCell id="c60" value="&lt;b&gt;7.&lt;/b&gt; Health checks (máx. 180 s):&lt;br&gt;/v3/api-docs en :8080, frontend :4200,&lt;br&gt;Swagger y OpenAPI vía nginx /api" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="c53"><mxGeometry x="850" y="160" width="210" height="80" as="geometry"/></mxCell><mxCell id="c61" value="&lt;b&gt;8.&lt;/b&gt; docker image prune -f" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="c53"><mxGeometry x="600" y="160" width="210" height="80" as="geometry"/></mxCell><mxCell id="c62" value="&lt;b&gt;✔ Despliegue terminado&lt;/b&gt;&lt;br&gt;nueva versión en producción" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="c53"><mxGeometry x="350" y="160" width="210" height="80" as="geometry"/></mxCell><mxCell id="e63" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c54" target="c55"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e64" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c55" target="c56"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e65" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c56" target="c57"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e66" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c57" target="c58"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e67" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c58" target="c59"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e68" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c59" target="c60"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e69" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c60" target="c61"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e70" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c61" target="c62"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c71" value="&lt;b&gt;Si algo falla&lt;/b&gt;&lt;br&gt;El script usa &lt;i&gt;set -Eeuo pipefail&lt;/i&gt;: cualquier error o un health check que no responde a tiempo lo detiene, y el job deploy queda en rojo en GitHub." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="c53"><mxGeometry x="1350" y="40" width="320" height="110" as="geometry"/></mxCell><mxCell id="e72" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#9673a6;fontColor=#6a4c80;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c4" target="c18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="460" y="235"/><mxPoint x="240" y="235"/></Array></mxGeometry></mxCell><mxCell id="e73" value="dispara CI" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#9673a6;fontColor=#6a4c80;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c6" target="c18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="920" y="235"/><mxPoint x="240" y="235"/></Array></mxGeometry></mxCell><mxCell id="e74" value="dispara CD (push a main)" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#9673a6;fontColor=#6a4c80;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c7" target="c42"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1150" y="555"/><mxPoint x="260" y="555"/></Array></mxGeometry></mxCell><mxCell id="e75" value="por SSH" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#9673a6;fontColor=#6a4c80;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c47" target="c54"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1570" y="805"/><mxPoint x="245" y="805"/></Array></mxGeometry></mxCell><mxCell id="c76" value="&lt;b&gt;Notas&lt;/b&gt;&lt;br&gt;• Las imágenes se etiquetan con el SHA del commit, así cada despliegue corresponde a una versión exacta del código.&lt;br&gt;• Las migraciones del esquema en EC2 son manuales (db/migrations y procedimiento en el README): el CD no ejecuta db/clinica_dental_schema.sql ni borra el volumen postgres_data." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="1120" width="1700" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
