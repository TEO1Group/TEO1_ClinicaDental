  <diagram name="Página-1" id="fjGPZJsRWTY5sUVAa0zB">
    <mxGraphModel dx="10877" dy="547" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml DiagramaFlujoClinicaDental\n\ntitle Flujo del sistema - Clínica Dental\n\nskinparam activity {\n  BackgroundColor #F7F9FA\n  BorderColor #2C7BE5\n  ArrowColor #2C7BE5\n  FontColor #2E3A45\n}\n\nskinparam swimlane {\n  BorderColor #2C7BE5\n  TitleBackgroundColor #2C7BE5\n  TitleFontColor #FFFFFF\n}\n\n|#EEF8F7|Paciente / Secretaría|\nstart\n:Registrar paciente\\n(DNI, nombre, email, password, etc.);\n|#E8F0FB|Sistema (Backend)|\n:Validar datos del paciente;\nif (¿Datos válidos?) then (No)\n  :Error 400\\n(datos inválidos);\n  stop\nendif\n:Paciente registrado (rol CLIENTE);\n\n|#EEF8F7|Admin|\n:Registrar doctor\\n(/admin/usuarios/crear,\\nrol DOCTOR, especialidad);\n|#E8F0FB|Sistema (Backend)|\n:Validar datos del doctor;\nif (¿Email único?) then (No)\n  :Error 409\\n\&quot;El email ya está registrado\&quot;;\n  stop\nendif\n:Doctor registrado (usuario + doctor);\n\n|#EEF8F7|Paciente / Secretaría|\n:Asignar horario al doctor\\n(ADMIN/SECRETARIA/DOCTOR);\n|#E8F0FB|Sistema (Backend)|\nif (¿Horario se cruza con otro?) then (Sí)\n  :Error 409\\n\&quot;horario cruzado\&quot;;\n  stop\nendif\n:Horario guardado;\n\n|#EEF8F7|Paciente / Secretaría|\n:Agendar cita\\n(doctor, fecha, hora, notas);\n|#E8F0FB|Sistema (Backend)|\n:Validar agendamiento;\n\nif (¿Doctor activo?) then (No)\n  :Error 409\\n(doctor inactivo);\n  stop\nendif\n\nif (¿Paciente activo?) then (No)\n  :Error 409\\n(paciente inactivo);\n  stop\nendif\n\nif (¿Paciente en lista negra?) then (Sí)\n  :Error 403\\n(paciente en lista negra);\n  stop\nendif\n\nif (¿Paciente bloqueado por inasistencias?) then (Sí)\n  :Error 409\\n\&quot;El paciente tiene N inasistencias\\ny no puede agendar citas\&quot;;\n  stop\nendif\n\nif (¿Fecha/hora futura?) then (No)\n  :Error 400\\n(fecha pasada);\n  stop\nendif\n\nif (¿Cabe en horario del doctor?) then (No)\n  :Error 409\\n(fuera de horario);\n  stop\nendif\n\nif (¿Se cruza con bloqueo del doctor?) then (Sí)\n  :Error 409\\n\&quot;El doctor no atiende en ese horario: motivo\&quot;;\n  stop\nendif\n\nif (¿Se solapa con otra cita?) then (Sí)\n  :Error 409\\n\&quot;El doctor ya tiene una cita\\nagendada en ese horario\&quot;;\n  stop\nendif\n\n:Cita creada con estado AGENDADA;\n|#F0F7F0|Doctor|\n:Cita AGENDADA;\n\n|#EEF8F7|Paciente / Secretaría|\n:Cancelar cita\\n(CLIENTE/SECRETARIA/ADMIN, motivo obligatorio);\n\n|#E8F0FB|Sistema (Backend)|\nif (¿Es CLIENTE?) then (Sí)\n  if (¿24h+ de anticipación?) then (No)\n    :Error 409\\n\&quot;Debes cancelar con al menos\\n24 horas de anticipación\&quot;;\n    stop\n  endif\nendif\nif (¿Motivo presente?) then (No)\n  :Error 400\\n(motivo obligatorio);\n  stop\nendif\n:Cita CANCELADA\\n(libera el horario);\nstop\n\n|#EEF8F7|Paciente / Secretaría|\n:Reprogramar cita\\n(CLIENTE/SECRETARIA/ADMIN, motivo obligatorio);\n|#E8F0FB|Sistema (Backend)|\nif (¿Es CLIENTE?) then (Sí)\n  if (¿24h+ de anticipación?) then (No)\n    :Error 409\\n\&quot;Debes reprogramar con al menos\\n24 horas de anticipación\&quot;;\n    stop\n  endif\nendif\nif (¿Motivo presente?) then (No)\n  :Error 400\\n(motivo obligatorio);\n  stop\nendif\nif (¿Nueva fecha/hora válida\\ny sin solape ni bloqueo?) then (No)\n  :Error 409\\n(fuera de horario/bloqueo/solape);\n  stop\nendif\n:Cita reprogramada\\n(misma cita, nueva fecha/hora);\nstop\n\n|#F0F7F0|Doctor|\n:Marcar cita como ATENDIDA\\n(solo desde la hora de inicio);\n|#E8F0FB|Sistema (Backend)|\nif (¿Cita AGENDADA?) then (No)\n  :Error 409\\n(cita ya en estado final);\n  stop\nendif\nif (¿Es DOCTOR de la cita?) then (No)\n  :Error 403\\n(solo el doctor de la cita);\n  stop\nendif\nif (¿Hora de inicio alcanzada?) then (No)\n  :Error 409\\n\&quot;no puedes marcar antes de la hora\&quot;;\n  stop\nendif\n:Cita ATENDIDA;\n|#F0F7F0|Doctor|\n:Registrar tratamiento en la cita\\n(doctor de la cita, cita ATENDIDA);\n|#E8F0FB|Sistema (Backend)|\nif (¿Cita ATENDIDA?) then (No)\n  :Error 409\\n\&quot;solo en cita ATENDIDA\&quot;;\n  stop\nendif\n:Tratamiento registrado\\n(costo, observaciones);\nstop\n\n|#F0F7F0|Doctor|\n:Marcar cita como NO_ASISTIO;\n|#E8F0FB|Sistema (Backend)|\nif (¿Hora de inicio alcanzada?) then (No)\n  :Error 409\\n\&quot;no puedes marcar antes de la hora\&quot;;\n  stop\nendif\n:Cita NO_ASISTIO;\n:Incrementar contador de inasistencias;\nif (¿Contador &gt;= 3?) then (Sí)\n  :Paciente bloqueado para agendar;\n  |#EEF8F7|Admin / Secretaría|\n  :Levantar restricción\\n(motivo obligatorio);\n  |#E8F0FB|Sistema (Backend)|\n  if (¿Paciente bloqueado?) then (No)\n    :Error 409\\n\&quot;no tiene restricción\&quot;;\n    stop\n  endif\n  :Restricción levantada\\n(conteo reiniciado);\nendif\nstop\n\n|#EEF8F7|Admin / Secretaría|\n:Crear bloqueo de doctor\\n(inicio, fin, motivo);\n|#E8F0FB|Sistema (Backend)|\nif (¿Hay citas AGENDADAS\\nen ese periodo?) then (Sí)\n  :Error 409\\n\&quot;El doctor tiene citas\\nagendadas en ese periodo\&quot;;\n  stop\nendif\n:Bloqueo creado\\n(afecta agendar y reprogramar);\nstop\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="hacfIDlGNtMb5jhenby5-362">
