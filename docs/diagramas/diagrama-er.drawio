Cell><mxCell id="e_tratamiento_medicamento_id_tratamiento_fkey" value="" style="edgeStyle=none;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;startArrow=ERzeroToMany;startFill=0;endArrow=ERmandOne;endFill=0;startSize=12;endSize=12;jumpStyle=arc;jumpSize=10;strokeColor=#4d4d4d;strokeWidth=1.3;" edge="1" parent="1" source="c_tratamiento_medicamento__id_tratamiento" target="c_tratamiento__id_tratamiento"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e_usuario_id_rol_fkey" value="" style="edgeStyle=none;rounded=0;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;startArrow=ERzeroToMany;startFill=0;endArrow=ERmandOne;endFill=0;startSize=12;endSize=12;jumpStyle=arc;jumpSize=10;strokeColor=#4d4d4d;strokeWidth=1.3;" edge="1" parent="1" source="c_usuario__id_rol" target="c_rol__id_rol"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="412" y="334"/><mxPoint x="412" y="214"/></Array></mxGeometry></mxCell><mxCell id="e_valoracion_id_cita_fkey" value="" style="edgeStyle=none;rounded=0;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;startArrow=ERzeroToOne;startFill=0;endArrow=ERmandOne;endFill=0;startSize=12;endSize=12;jumpStyle=arc;jumpSize=10;strokeColor=#4d4d4d;strokeWidth=1.3;" edge="1" parent="1" source="c_valoracion__id_cita" target="c_cita__id_cita"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1344" y="628"/><mxPoint x="1344" y="496"/></Array></mxGeometry></mxCell><mxCell id="leyenda" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; llave primaria (nombre subrayado) · &lt;b&gt;FK&lt;/b&gt; llave foránea · &lt;b&gt;UQ&lt;/b&gt; valor único&lt;br&gt;&lt;i&gt;Cursiva&lt;/i&gt;: la columna admite NULL; las demás son NOT NULL&lt;br&gt;&lt;span style=&#x27;color:#6c8ebf&#x27;&gt;■&lt;/span&gt; Usuarios y perfiles&amp;nbsp;&amp;nbsp;&lt;span style=&#x27;color:#82b366&#x27;&gt;■&lt;/span&gt; Citas y agenda&amp;nbsp;&amp;nbsp;&lt;span style=&#x27;color:#d6b656&#x27;&gt;■&lt;/span&gt; Tratamientos y medicamentos&amp;nbsp;&amp;nbsp;&lt;span style=&#x27;color:#9673a6&#x27;&gt;■&lt;/span&gt; Planes e inasistencias&lt;br&gt;&lt;br&gt;&lt;b&gt;Cardinalidad&lt;/b&gt; (la línea une la FK con la columna que referencia)&lt;br&gt;Junto a la tabla referenciada: &lt;b&gt;dos rayas&lt;/b&gt; = uno obligatorio (FK NOT NULL); &lt;b&gt;círculo y raya&lt;/b&gt; = cero o uno (FK que admite NULL)&lt;br&gt;Junto a la FK: &lt;b&gt;pata de gallo con círculo&lt;/b&gt; = cero o muchos; &lt;b&gt;círculo y raya&lt;/b&gt; = cero o uno (FK con UNIQUE, relación 1 a 1)&lt;br&gt;&lt;b&gt;Línea punteada&lt;/b&gt;: FK que guarda qué usuario hizo la acción" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fontSize=13;rounded=1;arcSize=3;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1820" y="170" width="560" height="300" as="geometry"/></mxCell><mxCell id="reglas" value="&lt;b&gt;Valores permitidos (CHECK)&lt;/b&gt;&lt;br&gt;• cita.estado: AGENDADA, ATENDIDA, CANCELADA, NO_ASISTIO&lt;br&gt;• horario.dia_semana: LUNES, MARTES, MIERCOLES, JUEVES, VIERNES, SABADO, DOMINGO&lt;br&gt;• pago.estado: PAGADO, PENDIENTE, DEUDA&lt;br&gt;• plan_tratamiento.estado: ACTIVO, COMPLETADO, CANCELADO&lt;br&gt;• rol.nombre_rol: ADMIN, DOCTOR, SECRETARIA, CLIENTE&lt;br&gt;• secretaria.turno: MANANA, TARDE, NOCHE&lt;br&gt;• usuario.estado: ACTIVO, INACTIVO&lt;br&gt;&lt;br&gt;&lt;b&gt;Otras validaciones (CHECK)&lt;/b&gt;&lt;br&gt;• abono_plan: monto &amp;gt; 0&lt;br&gt;• bloqueo_doctor: fin &amp;gt; inicio&lt;br&gt;• cita_tratamiento: costo &amp;gt;= 0&lt;br&gt;• horario: hora_fin &amp;gt; hora_inicio&lt;br&gt;• levantamiento_inasistencia: inasistencias &amp;gt;= 0&lt;br&gt;• medicamento: stock &amp;gt;= 0&lt;br&gt;• pago: monto &amp;gt;= 0&lt;br&gt;• plan_tratamiento: costo_total &amp;gt;= 0&lt;br&gt;• plan_tratamiento: total_sesiones &amp;gt; 0&lt;br&gt;• tratamiento: costo &amp;gt;= 0&lt;br&gt;• tratamiento: duracion_minutos &amp;gt; 0&lt;br&gt;• tratamiento_medicamento: cantidad &amp;gt; 0&lt;br&gt;• valoracion: puntuacion &amp;gt;= 1 AND puntuacion &amp;lt;= 5&lt;br&gt;&lt;br&gt;&lt;b&gt;Índices únicos&lt;/b&gt;&lt;br&gt;• uq_cita_doctor_slot: cita (id_doctor, fecha, hora) WHERE estado &amp;lt;&amp;gt; &amp;#x27;CANCELADA&amp;#x27;&lt;br&gt;• uq_tratamiento_nombre: tratamiento (nombre)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fontSize=13;rounded=1;arcSize=3;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1820" y="500" width="560" height="600" as="geometry"/></mxCell><mxCell id="acciones" value="&lt;b&gt;Al borrar el registro referenciado (ON DELETE)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;CASCADE&lt;/b&gt; (18 FK): se borran también los registros que lo referencian. Es el caso de todas las FK que no aparecen abajo.&lt;br&gt;• &lt;b&gt;SET NULL&lt;/b&gt; (5 FK): abono_plan.registrado_por, bloqueo_doctor.creado_por, cita.id_plan, cita_reprogramacion.reprogramado_por, levantamiento_inasistencia.levantado_por&lt;br&gt;• &lt;b&gt;NO ACTION&lt;/b&gt; (3 FK, impide borrar si hay registros que lo usan): cita_tratamiento.id_tratamiento, plan_tratamiento.id_tratamiento, usuario.id_rol" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fontSize=13;rounded=1;arcSize=3;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1820" y="1130" width="560" height="210" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>